#!/bin/bash
set -e

# Kamal health-checks only proxied roles; the smtp and imap roles publish
# raw TCP ports with no proxy in front, so a deploy that left them unbound
# would otherwise look green. Probe every published mail port on every
# host right after the deploy; a port that never answers fails the deploy
# loudly (the containers keep running for inspection: `bin/kamal
# smtp-logs` / `imap-logs`).

[ "$KAMAL_SERVICE" = "mail_on_rails" ] || exit 0

MAIL_PORTS="${MAIL_PORTS:-25 587 465 143 993}"
ATTEMPTS="${MAIL_PORT_ATTEMPTS:-30}"

# One connect per (address, port). 127.0.0.1 exercises the IPv4 publish;
# the host's global IPv6 address (when it has one) exercises the ip6tables
# DNAT path - bash's /dev/tcp takes a bare v6 literal - so a v6 publish
# that silently broke fails the deploy too.
probe() {
  local host=$1 addr=$2 port=$3
  for _ in $(seq 1 "$ATTEMPTS"); do
    if ssh "root@$host" "timeout 3 bash -c 'exec 3<>/dev/tcp/$addr/$port' 2>/dev/null"; then
      return 0
    fi
    sleep 2
  done
  return 1
}

IFS=',' read -ra HOSTS <<< "$KAMAL_HOSTS"
for host in "${HOSTS[@]}"; do
  addrs="127.0.0.1"
  v6=$(ssh "root@$host" "ip -6 -o addr show scope global 2>/dev/null | awk '{print \$4}' | cut -d/ -f1 | head -1")
  [ -n "$v6" ] && addrs="$addrs $v6"
  for addr in $addrs; do
    for port in $MAIL_PORTS; do
      if probe "$host" "$addr" "$port"; then
        echo "mail port $port answers on $host ($addr)"
      else
        echo "mail port $port never answered on $host ($addr) after $ATTEMPTS attempts" >&2
        exit 1
      fi
    done
  done
done
