#!/usr/bin/env sh
#
# Runs locally after `kamal setup` / `kamal server bootstrap` has installed
# Docker on each fresh host. We use it to apply one-time server hardening.
# Idempotent: safe to re-run on an already-hardened host.
#
# KAMAL_HOSTS is a comma-separated list of the hosts being set up.

set -e

for host in $(echo "$KAMAL_HOSTS" | tr ',' ' '); do
  echo "Hardening $host..."
  ssh -o BatchMode=yes "root@$host" 'sh -s' <<'EOF'
set -e
export DEBIAN_FRONTEND=noninteractive

# --- Swap --------------------------------------------------------------------
# The droplet has 2 GB of RAM and runs the whole stack (postgres, puma +
# solid queue with the in-process SMTP/IMAP servers, rspamd, and clamd,
# which alone wants
# ~1.5 GB resident). A 6 GB swapfile keeps deploy-time and signature-reload
# spikes from OOM-killing anything. swappiness is kept low so hot pages
# (clamd's signature database in particular) stay in RAM.
if ! swapon --show=NAME --noheadings | grep -q '^/swapfile$'; then
  fallocate -l 6G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=6144
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo "Created 6G /swapfile"
fi
grep -q '^/swapfile ' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab
cat > /etc/sysctl.d/61-swap.conf <<'CONF'
vm.swappiness = 10
vm.vfs_cache_pressure = 50
CONF

# --- Packages: automatic security updates + ssh brute-force protection ----
apt-get update -q
apt-get install -qy unattended-upgrades fail2ban ufw

# Unattended security upgrades (Ubuntu/Debian defaults are fine; make sure
# the periodic timers are on).
cat > /etc/apt/apt.conf.d/20auto-upgrades <<'CONF'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
CONF

# --- SSH hardening ---------------------------------------------------------
# Key-only auth; root allowed with keys only (kamal deploys as root).
mkdir -p /etc/ssh/sshd_config.d
#
# MaxStartups/PerSourceMaxStartups: a public droplet gets scanned constantly,
# and every scanner sitting in the pre-auth handshake holds one of sshd's
# unauthenticated slots. With the stock 10:30:100 that pool is routinely full,
# and kamal - which opens several SSH sessions in parallel per command - gets
# "kex_exchange_identification: Connection reset by peer" mid-deploy. Widen the
# global pool but cap it per source address, so a single scanning IP can never
# crowd out a real deploy.
#
# PerSourcePenaltyExemptList: OpenSSH 9.8+ also penalises a source address for
# connections that close without authenticating (noauth:1, refuseconnection:10).
# Kamal's connection churn trips that and locks the deploy machine out of the
# box entirely for minutes. Exempt whoever is running this hook - $SSH_CLIENT
# is the address we are connected from right now, so this configures itself.
DEPLOY_IP=$(echo "$SSH_CLIENT" | awk '{print $1}')

cat > /etc/ssh/sshd_config.d/50-hardening.conf <<CONF
PermitRootLogin prohibit-password
PasswordAuthentication no
KbdInteractiveAuthentication no
X11Forwarding no
MaxAuthTries 3
LoginGraceTime 20
MaxStartups 100:30:200
PerSourceMaxStartups 20
PerSourceNetBlockSize 32
${DEPLOY_IP:+PerSourcePenaltyExemptList $DEPLOY_IP}
CONF
sshd -t && systemctl reload ssh 2>/dev/null || systemctl reload sshd

# --- fail2ban: jail sshd ----------------------------------------------------
cat > /etc/fail2ban/jail.local <<'CONF'
[DEFAULT]
bantime  = 1h
findtime = 10m
maxretry = 5

[sshd]
enabled = true
CONF
systemctl enable --now fail2ban
systemctl restart fail2ban

# --- Firewall ---------------------------------------------------------------
# NOTE: Docker publishes container ports via its own iptables/ip6tables
# chains, which BYPASS ufw (v4 and v6 alike) - the mail/web ports (25, 80,
# 443, 143, 993, ...) are exposed by the kamal-managed containers regardless
# of these rules. ufw still protects any daemons listening directly on the
# host (including docker-proxy's own sockets).
ufw allow OpenSSH
ufw --force enable

# --- IPv6 -------------------------------------------------------------------
# DigitalOcean hands existing droplets their IPv6 allocation via the
# metadata service but never rewrites cloud-init's netplan for it, so the
# address has to be configured by hand. A separate netplan file keeps
# cloud-init from clobbering it on a rebuild. accept-ra off: Docker turns
# on ipv6 forwarding for its networks, and a forwarding host ignores RAs
# anyway - the static route is the only one we want.
META=http://169.254.169.254/metadata/v1/interfaces/public/0/ipv6
V6_ADDR=$(curl -fs -m 3 "$META/address" 2>/dev/null || true)
V6_CIDR=$(curl -fs -m 3 "$META/cidr" 2>/dev/null || true)
V6_GW=$(curl -fs -m 3 "$META/gateway" 2>/dev/null || true)
if [ -n "$V6_ADDR" ] && [ -n "$V6_GW" ]; then
  cat > /etc/netplan/60-ipv6.yaml <<CONF
network:
  version: 2
  ethernets:
    eth0:
      accept-ra: false
      addresses: ["$V6_ADDR/${V6_CIDR:-64}"]
      routes:
        - to: "::/0"
          via: "$V6_GW"
CONF
  chmod 600 /etc/netplan/60-ipv6.yaml
  netplan apply
  echo "IPv6 configured: $V6_ADDR via $V6_GW"
fi

# The kamal docker network must exist with IPv6 enabled BEFORE kamal's own
# `docker network create kamal` (kamal treats "already exists" as fine).
# Docker cannot add IPv6 to an existing network, and without it a v6 client
# reaches the containers through docker-proxy with its source address
# rewritten to the bridge gateway - every per-IP defence would see
# 172.18.0.1. The ULA /64 is auto-assigned; ip6tables (docker-managed by
# default) DNATs published ports and masquerades egress.
if ! docker network inspect kamal >/dev/null 2>&1; then
  docker network create --ipv6 --subnet 172.18.0.0/16 --gateway 172.18.0.1 kamal
  echo "Created IPv6-enabled kamal network"
fi

# --- Kernel/network hardening ------------------------------------------------
cat > /etc/sysctl.d/60-hardening.conf <<'CONF'
# SYN-flood protection
net.ipv4.tcp_syncookies = 1
# Ignore ICMP redirects / don't send them (we are not a router)
net.ipv4.conf.all.accept_redirects = 0
net.ipv6.conf.all.accept_redirects = 0
net.ipv4.conf.all.send_redirects = 0
# No source-routed packets
net.ipv4.conf.all.accept_source_route = 0
net.ipv6.conf.all.accept_source_route = 0
# Reverse-path filtering (spoofing protection)
net.ipv4.conf.all.rp_filter = 1
net.ipv4.conf.default.rp_filter = 1
# Log martians
net.ipv4.conf.all.log_martians = 1
# Restrict kernel log / pointers from unprivileged users
kernel.dmesg_restrict = 1
kernel.kptr_restrict = 2
CONF
sysctl --system > /dev/null

echo "Hardening complete on $(hostname)"
EOF
done
