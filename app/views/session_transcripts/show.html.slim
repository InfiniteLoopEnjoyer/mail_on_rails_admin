- page_title "Session transcript"
- back_path = @transcript.protocol == "imap" ? imap_path : smtp_path

header.mb-4.flex.flex-wrap.items-center.justify-between.gap-x-3.gap-y-2
  h1.text-2xl.font-bold
    | Session transcript
    span.ml-2.font-mono.text-lg.text-slate-500.dark:text-slate-400= @transcript.ip
  = link_to "← Back", back_path, class: "text-sm text-slate-500 dark:text-slate-400 hover:text-accent hover:underline"

section.mb-5.grid.gap-3 class="sm:grid-cols-2 lg:grid-cols-4"
  - tiles = [["Closed", @transcript.closed_at.strftime("%b %-d %Y %H:%M")], ["Protocol", @transcript.protocol.upcase], ["Listener", @transcript.port], ["Close reason", @transcript.close_reason&.tr("_", " ") || "-"]]
  - tiles << ["User", @transcript.username] if @transcript.username
  - tiles << ["HELO", @transcript.helo] if @transcript.helo
  - tiles << ["Duration", duration_label(@transcript.closed_at - @transcript.connected_at)] if @transcript.connected_at
  - tiles.each do |label, value|
    .rounded-lg.border.border-slate-200.dark:border-slate-800.bg-white.dark:bg-slate-900.px-4.py-3
      .text-xs.text-slate-500.dark:text-slate-400= label
      .text-lg.font-semibold.break-words= value

section.rounded-lg.border.border-slate-200.dark:border-slate-800.bg-white.dark:bg-slate-900
  header.flex.items-center.justify-between.border-b.border-slate-200.dark:border-slate-800.px-4.py-3
    div
      h2.font-semibold Captured dialogue
      p.text-sm.text-slate-500.dark:text-slate-400
        ' Command/reply exchange as the server saw it (
        code.text-xs <=
        '  from peer,
        code.text-xs =>
        '  from server). Credentials are redacted at capture and message bodies are never recorded.
    - if @transcript.ip.present?
      = render "auth_attempts/ban_button", target: @transcript.ip, confirm: "Permanently ban #{@transcript.ip}? On a shared address this can affect other users. It loses SMTP, IMAP and web login access."
  - if @transcript.transcript.present?
    pre.overflow-x-auto.p-4.text-xs.leading-relaxed.font-mono.text-slate-700.dark:text-slate-300= @transcript.transcript
  - else
    p.px-4.py-3.text-sm.text-slate-500.dark:text-slate-400 Nothing captured.
