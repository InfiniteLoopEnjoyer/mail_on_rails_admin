/ The plaintext rides in a single data attribute that secret_controller
/ strips from the DOM on connect and keeps in JS memory; the wrapper is
/ data-turbo-temporary so no Turbo snapshot retains it either way.
div data-controller="secret" data-secret-value=password data-turbo-temporary=true
  button.cursor-pointer.rounded-md.border.border-slate-200.dark:border-slate-800.bg-slate-100.dark:bg-slate-800.px-3.py-1.5.font-mono.text-sm type="button" title="Click to reveal, click again to copy" data-action="secret#activate"
    code data-secret-target="display" ••••••••••••••••••••
  span.ml-2.text-xs.text-green-700.dark:text-green-400 hidden=true data-secret-target="feedback" Copied!
  p.mt-2.text-xs.text-slate-500.dark:text-slate-400 Shown only once - click to reveal, click again to copy. It cannot be recovered, only regenerated.
