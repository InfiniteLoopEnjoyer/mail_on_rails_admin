- page_title "Accounts"

= turbo_stream_from :email_accounts

header.mb-4.flex.flex-wrap.items-center.justify-between.gap-x-3.gap-y-2
  h1.text-2xl.font-bold Email Accounts
  .flex.items-center.gap-2
    = link_to "New email", new_email_path, class: "inline-block cursor-pointer rounded-md border border-accent bg-accent px-3.5 py-1 text-sm font-medium text-white"
    - if Current.user.admin?
      = link_to "New account", new_email_account_path, class: "inline-block cursor-pointer rounded-md border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-3.5 py-1 text-sm font-medium text-slate-800 dark:text-slate-100"

- if @account_sections.any?
  - @account_sections.each do |heading, accounts|
    section.mt-8.first:mt-0
      h2.mb-2.text-sm.font-semibold.uppercase.tracking-wide.text-slate-500.dark:text-slate-400= heading
      ul
        = render partial: "account", collection: accounts
- else
  p.text-slate-500.dark:text-slate-400
    - if Current.user.admin?
      ' No email accounts yet. Create one above, or run
      code bin/rails db:seed
      | .
    - else
      | No email accounts have been shared with you yet.
