- page_title "Source · #{@email_message.subject.presence || "(no subject)"}"

nav.mb-2.text-sm.text-slate-500.dark:text-slate-400
  =<> link_to "Accounts", root_path, class: "text-accent"
  | /
  =<> link_to @email_account.email, email_account_path(@email_account), class: "text-accent"
  | /
  =<> link_to @mailbox.name, email_account_mailbox_path(@email_account, @mailbox), class: "text-accent"
  | /
  =<> link_to @email_message.subject.presence || "(no subject)", email_account_mailbox_email_message_path(@email_account, @mailbox, @email_message), class: "text-accent"
  | /
  span<> Source

article.rounded-lg.border.border-slate-200.dark:border-slate-800.bg-white.dark:bg-slate-900.px-5.py-4
  header.mb-3.flex.flex-wrap.items-center.justify-between.gap-3
    h1.text-xl.font-bold Message source
    .flex.flex-wrap.items-center.gap-2
      = link_to "Back to message", email_account_mailbox_email_message_path(@email_account, @mailbox, @email_message),
                class: "cursor-pointer rounded-md border border-slate-300 dark:border-slate-600 px-3 py-1 text-sm whitespace-nowrap text-slate-600 dark:text-slate-300 hover:border-accent hover:text-accent"
      = link_to "Download .eml", download_email_account_mailbox_email_message_path(@email_account, @mailbox, @email_message),
                class: "cursor-pointer rounded-md border border-slate-300 dark:border-slate-600 px-3 py-1 text-sm whitespace-nowrap text-slate-600 dark:text-slate-300 hover:border-accent hover:text-accent", data: { turbo: false }
  / The raw RFC822 bytes, escaped by the template - the message's own HTML
  / stays visible as text here, never rendered.
  pre.rounded-md.bg-slate-50.dark:bg-slate-800.p-3.font-mono.text-xs.leading-relaxed.break-all.whitespace-pre-wrap= @source
