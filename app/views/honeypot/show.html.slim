- page_title "Honeypot event"
- enr = @event.enrichment&.with_indifferent_access

header.mb-4.flex.flex-wrap.items-center.justify-between.gap-x-3.gap-y-2
  h1.text-2xl.font-bold
    = @event.trigger.tr("_", " ").capitalize
    span.ml-2.font-mono.text-lg.text-slate-500.dark:text-slate-400= @event.ip
  = link_to "← Back", honeypot_events_path, class: "text-sm text-slate-500 dark:text-slate-400 hover:text-accent hover:underline"

section.mb-5.grid.gap-3 class="sm:grid-cols-2 lg:grid-cols-4"
  - tiles = [["When", @event.occurred_at.strftime("%b %-d %Y %H:%M")], ["Protocol", @event.protocol.upcase], ["Trigger", @event.trigger.tr("_", " ")], ["Automatic response", @event.response]]
  - tiles << ["Signature", @event.signature] if @event.signature
  - tiles << ["Account", @event.username] if @event.username
  - tiles.each do |label, value|
    .rounded-lg.border.border-slate-200.dark:border-slate-800.bg-white.dark:bg-slate-900.px-4.py-3
      .text-xs.text-slate-500.dark:text-slate-400= label
      .text-lg.font-semibold.break-words= value

- if enr.present? && enr.values.any?(&:present?)
  section.mb-5.rounded-lg.border.border-slate-200.dark:border-slate-800.bg-white.dark:bg-slate-900.px-4.py-3
    h2.mb-2.font-semibold Source attribution
    dl class="grid grid-cols-[8rem_1fr] gap-x-4 gap-y-1 text-sm"
      - [["ASN", enr[:asn] && "AS#{enr[:asn]}"], ["Network", enr[:as_name]], ["Country", enr[:country]], ["Prefix", enr[:prefix]], ["Reverse DNS", enr[:rdns]]].each do |label, value|
        - next if value.blank?
        dt.text-slate-500.dark:text-slate-400= label
        dd.font-mono.break-words= value

section.rounded-lg.border.border-slate-200.dark:border-slate-800.bg-white.dark:bg-slate-900
  header.flex.items-center.justify-between.border-b.border-slate-200.dark:border-slate-800.px-4.py-3
    h2.font-semibold Session transcript
    - if @event.ip.present?
      .flex.items-center.gap-2
        = button_to "Kick live connections", kick_honeypot_events_path, params: { ip: @event.ip }, class: "inline-block cursor-pointer rounded-md border border-slate-200 bg-white px-2 py-0.5 text-xs font-medium text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300", form: { class: "inline-block" }
        = render "auth_attempts/ban_button", target: @event.ip, confirm: "Permanently ban #{@event.ip}? On a shared address this can affect other users. It loses SMTP, IMAP and web login access."
  - if @event.transcript.present?
    pre.overflow-x-auto.p-4.text-xs.leading-relaxed.font-mono.text-slate-700.dark:text-slate-300= @event.transcript
  - else
    p.px-4.py-3.text-sm.text-slate-500.dark:text-slate-400 No transcript captured.
