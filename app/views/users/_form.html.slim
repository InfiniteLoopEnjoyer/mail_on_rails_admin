= form_with model: user, class: "max-w-lg rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5" do |form|
  - if user.errors.any?
    .mb-4.rounded-md.bg-red-100.dark:bg-red-950.px-3.py-2.text-sm.text-red-700.dark:text-red-400
      ul.list-disc.pl-4
        - user.errors.full_messages.each do |message|
          li= message

  .mb-4
    = form.label :email_address, class: "mb-1 block text-sm font-semibold"
    = form.email_field :email_address, required: true, autofocus: user.new_record?, class: "w-full rounded-md border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-800 px-2.5 py-1.5"

  - if Current.user.admin?
    .mb-4
      = form.label :role, class: "mb-1 block text-sm font-semibold"
      = form.select :role, User::ROLES, {}, class: "w-full rounded-md border border-slate-200 dark:border-slate-800 bg-slate-100 dark:bg-slate-800 px-2.5 py-1.5"

    - unless user.new_record?
      .mb-4
        h2.mb-1.text-sm.font-semibold Granted email accounts
        p.mb-2.text-xs.text-slate-500.dark:text-slate-400 Grants apply to members only; admins can access every account.
        - if MailOnRails::EmailAccount.any?
          .space-y-1
            = form.collection_check_boxes :email_account_ids, MailOnRails::EmailAccount.order(:email), :id, :email do |builder|
              label.flex.items-center.gap-2.text-sm
                = builder.check_box class: "rounded border-slate-300 dark:border-slate-700"
                = builder.text
        - else
          p.text-xs.text-slate-500.dark:text-slate-400 No email accounts exist yet.

  - if user.new_record?
    p.mb-4.text-xs.text-slate-500.dark:text-slate-400 A password will be generated when the user is created.

  .mt-5
    = form.submit class: "inline-block cursor-pointer rounded-md border border-accent bg-accent px-3.5 py-1 text-sm font-medium text-white"
